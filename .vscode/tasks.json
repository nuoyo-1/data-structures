{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "准备构建目录（同步源码到 ASCII 路径）",
            "type": "process",
            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": [
                "-NoProfile",
                "-NonInteractive",
                "-Command",
                "New-Item -ItemType Directory -Force -Path '${workspaceFolder}\\.build' | Out-Null; Copy-Item -LiteralPath '${file}' -Destination '${workspaceFolder}\\.build\\${fileBasename}' -Force"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": false
            }
        },
        {
            "type": "process",
            "label": "C/C++: gcc.exe 生成活动文件",
            "command": "C:\\msys64\\mingw64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-Wall",
                "-g",
                "-finput-charset=UTF-8",
                "-fexec-charset=UTF-8",
                "${workspaceFolder}\\.build\\${fileBasename}",
                "-o",
                "${workspaceFolder}\\.build\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\.build"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": "准备构建目录（同步源码到 ASCII 路径）",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "把源文件复制到纯 ASCII 的 .build 目录再编译。gdb 在中文系统上按 GBK 解析路径，无法处理中文目录，因此编译和调试路径都必须不含中文。"
        }
    ]
}